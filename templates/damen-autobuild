#!/usr/bin/env bash
# AutoBuild commands for Damen (your normal account).
#   autobuild status / stop / log / check / test-ping / github-login   - passed to the builds account
#   autobuild share <folder>    - let AutoBuild work on a project folder on this server (read-only copy)
#   autobuild unshare <name>    - stop sharing a project folder
#   autobuild bring <name>      - bring finished work back: adds AutoBuild's branch to your project
#                                 (or puts a new project in ~/autobuild-builds/<name>)
set -uo pipefail
NEWU=autobuild
NEWHOME=$(getent passwd "$NEWU" | cut -d: -f6)
IN=/srv/autobuild-in
OUT=/srv/autobuild-out
ok()   { printf "\033[1;32mOK:\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m %s\n" "$*"; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-//' -e 's/-$//'; }
field() { grep -m1 "^$1=" "$2" 2>/dev/null | cut -d= -f2-; }

case "${1:-help}" in
  share)
    [ -n "${2:-}" ] || { echo "Usage: autobuild share <project folder>"; exit 1; }
    path=$(cd "$2" 2>/dev/null && pwd -P) || { warn "Folder not found: $2"; exit 1; }
    if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      warn "$path isn't a git project yet. AutoBuild needs git so it can work on its own branch."
      echo "   To make it one (safe, doesn't change your files):"
      echo "     cd \"$path\" && git init && git add -A && git commit -m \"Starting point\""
      echo "   Check 'git status' first so secrets like .env files aren't added (put them in .gitignore)."
      exit 1
    fi
    path=$(git -C "$path" rev-parse --show-toplevel)
    [ -w "$IN" ] || { warn "$IN isn't set up. Run update.sh from the AutoBuild package first."; exit 1; }
    existing=$(grep -lxF "$path" "$IN"/*.path 2>/dev/null | head -n1)
    if [ -n "$existing" ]; then name=$(basename "${existing%.path}"); else
      name=$(slugify "$(basename "$path")"); n=2
      while [ -e "$IN/$name.git" ]; do name="$(slugify "$(basename "$path")")-$n"; n=$((n + 1)); done
      git clone -q --mirror "$path" "$IN/$name.git" || { warn "Couldn't copy $path"; exit 1; }
      echo "$path" > "$IN/$name.path"
    fi
    git -C "$IN/$name.git" remote update --prune >/dev/null 2>&1
    chmod -R a+rX "$IN/$name.git" "$IN/$name.path"
    line="*/5 * * * * $HOME/autobuild/bin/autobuild refresh-shares >/dev/null 2>&1"
    crontab -l 2>/dev/null | grep -q 'refresh-shares' || ( crontab -l 2>/dev/null; echo "$line" ) | crontab -
    [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ] && \
      warn "You have uncommitted changes in $path. AutoBuild only sees committed work."
    ok "Shared $path (AutoBuild gets a read-only copy, refreshed every 5 minutes)."
    echo "   In ChatGPT plans for this project, use:   repo: $path" ;;
  refresh-shares)
    for p in "$IN"/*.path; do
      [ -f "$p" ] || continue; m="${p%.path}.git"
      git -C "$m" remote update --prune >/dev/null 2>&1 && chmod -R a+rX "$m" 2>/dev/null
    done ;;
  unshare)
    name="${2:?Usage: autobuild unshare <name>  (see: ls $IN)}"
    rm -rf "$IN/$name.git" "$IN/$name.path" && ok "Stopped sharing $name" ;;
  bring)
    name="${2:?Usage: autobuild bring <project-name>}"
    info="$OUT/$name.info"; bundle="$OUT/$name.bundle"
    [ -f "$info" ] || { warn "Nothing to bring for '$name' yet (check the name with: autobuild status)."; exit 1; }
    kind=$(field kind "$info"); repo=$(field repo "$info"); branch=$(field branch "$info")
    if [ "$kind" = "existing" ] && [ "${repo#/}" = "$repo" ]; then
      ok "This one is on GitHub: branch $branch in $repo"
      echo "   In your own copy:  git fetch && git log --oneline HEAD..origin/$branch"; exit 0
    fi
    [ -f "$bundle" ] || { warn "No saved work yet for $name - it's saved at the end of each work round."; exit 1; }
    if [ "$kind" = "existing" ]; then
      [ "$(git -C "$repo" rev-parse --abbrev-ref HEAD)" = "$branch" ] && { warn "You're on branch $branch in $repo. Switch to another branch first (git checkout main), then run this again."; exit 1; }
      git -C "$repo" fetch -q "$bundle" "+$branch:$branch" || { warn "Couldn't add the branch to $repo"; exit 1; }
      ok "AutoBuild's work is now branch '$branch' in $repo (your current branch wasn't touched)."
      echo "   See what changed:  git -C \"$repo\" log --oneline HEAD..$branch"
      echo "   Try it:            git -C \"$repo\" checkout $branch"
    else
      dest="$HOME/autobuild-builds/$name"
      if [ -d "$dest/.git" ]; then
        git -C "$dest" pull -q --ff-only "$bundle" "$branch" && ok "Updated $dest"
      else
        mkdir -p "$HOME/autobuild-builds" && git clone -q "$bundle" "$dest" -b "$branch" && ok "Copied to $dest"
      fi
    fi ;;
  help|-h|--help)
    sed -n '2,8p' "$0" ;;
  *)
    exec sudo -iu "$NEWU" "$NEWHOME/autobuild/bin/autobuild" "$@" ;;
esac
