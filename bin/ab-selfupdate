#!/usr/bin/env bash
# Keeps AutoBuild up to date from GitHub (github.com/damenOvernz/autobuild). Runs every 10 minutes.
#   ab-selfupdate            - update now if there's a newer version
#   ab-selfupdate --install  - one-time: turn on automatic updates
# Files are swapped in safely (a build that's running keeps using the version it started with).
set -uo pipefail
AB_HOME="${AB_HOME:-$HOME/autobuild}"
SRC="$HOME/autobuild-src"
REPO="https://github.com/damenOvernz/autobuild.git"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$AB_HOME/update.log"; }

if [ "${1:-}" = "--install" ]; then
  line="*/10 * * * * $SRC/bin/ab-selfupdate >/dev/null 2>&1"
  ( crontab -l 2>/dev/null | grep -v 'ab-selfupdate'; echo "$line" ) | crontab -
  echo "OK: automatic updates are on (checks GitHub every 10 minutes)."
fi

[ -d "$SRC/.git" ] || git clone -q "$REPO" "$SRC" || { log "clone failed"; exit 1; }
git -C "$SRC" fetch -q origin main || { log "fetch failed"; exit 1; }
new=$(git -C "$SRC" rev-parse origin/main)
have=$(cat "$AB_HOME/.version" 2>/dev/null || echo none)
[ "$new" = "$have" ] && [ "${1:-}" != "--install" ] && exit 0
git -C "$SRC" reset -q --hard origin/main

# Safety: only install if every script is valid (a bad update is skipped, the current version keeps running)
for f in "$SRC"/bin/* "$SRC"/templates/damen-autobuild; do
  case "$f" in
    */ab-activity) python3 -m py_compile "$f" 2>/dev/null || { log "skipped update: $f has errors"; exit 1; } ;;
    *) bash -n "$f" 2>/dev/null || { log "skipped update: $f has errors"; exit 1; } ;;
  esac
done

swap() { # copy to a temp name, then rename: running scripts keep their old copy
  local from="$1" to="$2"
  cp "$from" "$to.new.$$" && chmod +x "$to.new.$$" 2>/dev/null; mv -f "$to.new.$$" "$to"
}
mkdir -p "$AB_HOME/bin" "$AB_HOME/templates"
for f in "$SRC"/bin/*; do swap "$f" "$AB_HOME/bin/$(basename "$f")"; done
for f in "$SRC"/templates/*; do swap "$f" "$AB_HOME/templates/$(basename "$f")"; chmod -x "$AB_HOME/templates/$(basename "$f")" 2>/dev/null; done
chmod +x "$AB_HOME"/bin/* "$SRC"/bin/* 2>/dev/null
echo "$new" > "$AB_HOME/.version"
log "updated to $(git -C "$SRC" log -1 --format='%h %s')"
[ "${1:-}" = "--install" ] && echo "OK: AutoBuild is on version $(git -C "$SRC" log -1 --format='%h - %s')"
exit 0
